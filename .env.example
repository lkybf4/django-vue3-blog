# 复制为 .env 后按实际部署环境填写
# 注意：settings.py 为开发配置，settings_production.py 为生产配置

# ---------------------------------------------------------------------------
# 开发环境
# ---------------------------------------------------------------------------
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# 生产环境必填（DJANGO_SETTINGS_MODULE=blog_backend.settings_production）
# ---------------------------------------------------------------------------
SECRET_KEY=请替换为随机 50 位以上字符串
# Render 的 PostgreSQL 连接串，例如：
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 允许访问后端的域名（逗号分隔，不带协议）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 允许跨域的前端地址（逗号分隔，带协议）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 可选：配置后启用 Redis 缓存，不配置则使用进程内缓存
REDIS_URL=

# 可选：确认全站 HTTPS 后设为 True（Render / Cloudflare 终止 TLS 时可开启）
SECURE_SSL_REDIRECT=False

# ---------------------------------------------------------------------------
# 可选功能
# ---------------------------------------------------------------------------
# Elasticsearch（不配置或 USE_ELASTICSEARCH=false 时走数据库降级）
USE_ELASTICSEARCH=false
ELASTICSEARCH_HOSTS=http://localhost:9200

# GitHub OAuth（客户端代码已完成，路由尚未挂载）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 微信 OAuth（客户端代码已完成，路由尚未挂载）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
